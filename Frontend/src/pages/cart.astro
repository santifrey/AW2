---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Carrito - TiendaTech">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-8">Carrito de Compras</h1>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      <div id="cart-items" class="space-y-6">
        <!-- Cart items will be rendered here by JS -->
      </div>
      
      <div id="empty-cart-msg" class="hidden text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <p class="mt-4 text-gray-500 text-lg">Tu carrito está vacío.</p>
        <a href="/" class="mt-4 inline-block text-indigo-600 hover:text-indigo-800 font-medium">Volver a la tienda</a>
      </div>

      <div id="cart-summary" class="hidden mt-8 border-t pt-6">
        <div class="flex justify-between items-center text-xl font-bold text-gray-900 mb-6">
          <span>Total:</span>
          <span id="cart-total">$0</span>
        </div>

        <div id="auth-warning" class="hidden bg-yellow-50 text-yellow-800 p-4 rounded-md mb-6 border border-yellow-200">
          <p class="text-sm">Debes <a href="/login" class="underline font-bold">iniciar sesión</a> para completar tu compra.</p>
        </div>

        <button id="checkout-btn" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200 text-lg">
          Finalizar Compra
        </button>
      </div>

      <!-- Success message -->
      <div id="success-msg" class="hidden text-center py-12">
        <svg class="mx-auto h-16 w-16 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h2 class="mt-4 text-2xl font-bold text-gray-900">¡Compra Exitosa!</h2>
        <p class="mt-2 text-gray-600">Tu orden de compra ha sido generada correctamente.</p>
        <a href="/" class="mt-6 inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-6 rounded-lg transition">Seguir Comprando</a>
      </div>
    </div>
  </div>

  <script>
    import { API_URL } from '../config.js';

    const cartItemsContainer = document.getElementById('cart-items');
    const emptyCartMsg = document.getElementById('empty-cart-msg');
    const cartSummary = document.getElementById('cart-summary');
    const cartTotalEl = document.getElementById('cart-total');
    const checkoutBtn = document.getElementById('checkout-btn');
    const authWarning = document.getElementById('auth-warning');
    const successMsg = document.getElementById('success-msg');

    function renderCart() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const user = JSON.parse(localStorage.getItem('user') || 'null');

      if (cart.length === 0) {
        cartItemsContainer.classList.add('hidden');
        cartSummary.classList.add('hidden');
        emptyCartMsg.classList.remove('hidden');
        return;
      }

      emptyCartMsg.classList.add('hidden');
      cartItemsContainer.classList.remove('hidden');
      cartSummary.classList.remove('hidden');

      if (!user) {
        authWarning.classList.remove('hidden');
        checkoutBtn.disabled = true;
        checkoutBtn.classList.add('opacity-50', 'cursor-not-allowed');
      } else {
        authWarning.classList.add('hidden');
        checkoutBtn.disabled = false;
        checkoutBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }

      cartItemsContainer.innerHTML = '';
      let total = 0;

      cart.forEach((item, index) => {
        const itemTotal = item.precio * item.cantidad;
        total += itemTotal;

        const itemEl = document.createElement('div');
        itemEl.className = 'flex items-center justify-between border-b pb-4 last:border-0 last:pb-0';
        itemEl.innerHTML = `
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-gray-100 rounded-md flex items-center justify-center text-gray-400">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-medium text-gray-900">${item.nombre}</h3>
              <p class="text-gray-500 text-sm">$${item.precio.toLocaleString()} c/u</p>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <div class="flex items-center gap-3">
              <button class="decrease-btn w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 transition" data-index="${index}">-</button>
              <span class="font-medium w-4 text-center">${item.cantidad}</span>
              <button class="increase-btn w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 transition" data-index="${index}">+</button>
            </div>
            <div class="font-bold text-gray-900 w-24 text-right">$${itemTotal.toLocaleString()}</div>
            <button class="remove-btn text-red-500 hover:text-red-700 transition" data-index="${index}">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        `;
        cartItemsContainer.appendChild(itemEl);
      });

      cartTotalEl.innerText = `$${total.toLocaleString()}`;

      // Add event listeners for cart interactions
      document.querySelectorAll('.decrease-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = e.currentTarget.getAttribute('data-index');
          if (cart[index].cantidad > 1) {
            cart[index].cantidad -= 1;
            updateAndRender(cart);
          }
        });
      });

      document.querySelectorAll('.increase-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = e.currentTarget.getAttribute('data-index');
          cart[index].cantidad += 1;
          updateAndRender(cart);
        });
      });

      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const index = e.currentTarget.getAttribute('data-index');
          cart.splice(index, 1);
          updateAndRender(cart);
        });
      });
    }

    function updateAndRender(cart) {
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      renderCart();
    }

    checkoutBtn.addEventListener('click', async () => {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const user = JSON.parse(localStorage.getItem('user') || 'null');

      if (!user || cart.length === 0) return;

      checkoutBtn.disabled = true;
      checkoutBtn.innerText = 'Procesando...';

      // Create payload matching ventas.json expected format
      // { "id_usuario": 1, "productos": [...], "total": ... }
      const total = cart.reduce((acc, item) => acc + (item.precio * item.cantidad), 0);
      const productos = cart.map(item => ({ id_producto: item.id, cantidad: item.cantidad, precio_unitario: item.precio }));

      const payload = {
        id_usuario: user.id,
        fecha: new Date().toISOString(),
        total,
        productos
      };

      try {
        const res = await fetch(`${API_URL}/ventas`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          // Clear cart
          localStorage.removeItem('cart');
          window.dispatchEvent(new Event('cart-updated'));
          
          // Show success
          cartItemsContainer.classList.add('hidden');
          cartSummary.classList.add('hidden');
          successMsg.classList.remove('hidden');
        } else {
          const errorData = await res.json();
          alert('Error al procesar la compra: ' + (errorData.error || 'Desconocido'));
          checkoutBtn.disabled = false;
          checkoutBtn.innerText = 'Finalizar Compra';
        }
      } catch (err) {
        alert('Error de conexión con el servidor.');
        checkoutBtn.disabled = false;
        checkoutBtn.innerText = 'Finalizar Compra';
      }
    });

    // Initial render
    document.addEventListener('DOMContentLoaded', renderCart);
  </script>
</Layout>
