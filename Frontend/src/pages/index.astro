---
import Layout from '../layouts/Layout.astro';

// Fetch products at build time (or SSR if enabled)
let productos = [];
let error = null;

try {
  const res = await fetch('http://localhost:3000/productos');
  if (res.ok) {
    productos = await res.json();
  } else {
    error = 'No se pudieron cargar los productos';
  }
} catch (e) {
  error = 'Error de conexión con el servidor. Asegúrese de que el backend esté corriendo en el puerto 3000.';
}

const categorias = [...new Set(productos.map((p) => p.categoria).filter(Boolean))];
---

<Layout title="Catálogo de Productos - TiendaTech">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Nuestros Productos</h1>
    <p class="mt-3 text-xl text-gray-500 sm:mt-4">
      Encuentra el mejor equipamiento para tu setup.
    </p>
  </div>

  {error ? (
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-8">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-red-700">{error}</p>
        </div>
      </div>
    </div>
  ) : (
    <div class="flex flex-col md:flex-row gap-8">
      <!-- Sidebar / Filters -->
      <aside class="w-full md:w-64 flex-shrink-0">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
          <h2 class="text-lg font-medium text-gray-900 mb-4">Filtrar por Categoría</h2>
          <div class="space-y-2">
            <button class="filter-btn active w-full text-left px-3 py-2 rounded-md bg-indigo-50 text-indigo-700 font-medium transition" data-category="all">
              Todas
            </button>
            {categorias.map((cat) => (
              <button class="filter-btn w-full text-left px-3 py-2 rounded-md text-gray-600 hover:bg-gray-50 transition" data-category={cat}>
                {cat}
              </button>
            ))}
          </div>
        </div>
      </aside>

      <!-- Products Grid -->
      <div class="flex-1">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
          {productos.map((producto) => (
            <div class="product-card flex flex-col bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition duration-300" data-category={producto.categoria}>
              <div class="aspect-w-3 aspect-h-2 bg-gray-200">
                <!-- Fallback to a placeholder if image doesn't exist -->
                <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400">
                  <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{producto.nombre}</h3>
                    <span class="inline-block px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded-full mt-1">
                      {producto.categoria}
                    </span>
                  </div>
                  <p class="text-lg font-bold text-indigo-600">${producto.precio.toLocaleString()}</p>
                </div>
                <p class="mt-2 text-sm text-gray-500 line-clamp-2">{producto.desc}</p>
                
                <div class="mt-auto pt-4 flex items-center justify-between">
                  <span class="text-sm text-gray-500">Stock: {producto.stock}</span>
                  <button 
                    class="add-to-cart-btn bg-indigo-600 hover:bg-indigo-700 text-white p-2 rounded-lg transition"
                    data-product={JSON.stringify({
                      id: producto.id,
                      nombre: producto.nombre,
                      precio: producto.precio,
                      imagen: producto.imagen
                    })}
                    disabled={!producto.activo || producto.stock <= 0}
                    title={(!producto.activo || producto.stock <= 0) ? "No disponible" : "Añadir al carrito"}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
        {productos.length === 0 && !error && (
          <div class="text-center py-12">
            <p class="text-gray-500 text-lg">No hay productos disponibles en este momento.</p>
          </div>
        )}
      </div>
    </div>
  )}

  <script>
    // Filtering logic
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active state
        filterBtns.forEach(b => {
          b.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-medium', 'active');
          b.classList.add('text-gray-600', 'hover:bg-gray-50');
        });
        btn.classList.remove('text-gray-600', 'hover:bg-gray-50');
        btn.classList.add('bg-indigo-50', 'text-indigo-700', 'font-medium', 'active');

        const category = btn.getAttribute('data-category');

        productCards.forEach(card => {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Add to cart logic
    const addToCartBtns = document.querySelectorAll('.add-to-cart-btn');
    addToCartBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const productData = JSON.parse(btn.getAttribute('data-product'));
        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        
        const existingItem = cart.find(item => item.id === productData.id);
        if (existingItem) {
          existingItem.cantidad += 1;
        } else {
          cart.push({ ...productData, cantidad: 1 });
        }
        
        localStorage.setItem('cart', JSON.stringify(cart));
        
        // Dispatch custom event to update header count immediately
        window.dispatchEvent(new Event('cart-updated'));

        // Visual feedback
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
        btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
        btn.classList.add('bg-green-500', 'hover:bg-green-600');
        
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.classList.remove('bg-green-500', 'hover:bg-green-600');
          btn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
        }, 1000);
      });
    });
  </script>
</Layout>
